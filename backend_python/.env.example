BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:cloud
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TRP_MODEL=gemma4:cloud
OLLAMA_CLASSIFIER_MODEL=gemma4:cloud
OLLAMA_MAIN_THINK=false

WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

WHISPER_NO_SPEECH_THRESHOLD=0.8
WHISPER_LOG_PROB_THRESHOLD=-0.6

WARM_UP_WHISPER_ON_STARTUP=true

SMART_TURN_ENABLED=true
SMART_TURN_MODEL_PATH=models/smart-turn-v3.2-cpu.onnx
SMART_TURN_THRESHOLD=0.50
SMART_TURN_MAX_AUDIO_SECONDS=8.0

# Available values:
# - moonshine: streaming fast path with Whisper fallback
# - whisper: original batch-transcription path
TRANSCRIPTION_BACKEND=moonshine

MOONSHINE_LANGUAGE=en

# Leave empty to let moonshine-voice choose the standard model.
# Your downloaded medium streaming model reported architecture 5.
MOONSHINE_MODEL_ARCH=5

# How often Moonshine exposes updated partial text.
MOONSHINE_UPDATE_INTERVAL=0.2

WARM_UP_MOONSHINE_ON_STARTUP=true

# Startup inference warm-ups.
# LLM and TTS warm-ups make real provider calls.
WARM_UP_SMART_TURN_ON_STARTUP=true
WARM_UP_RETRIEVAL_ON_STARTUP=true
WARM_UP_LLM_ON_STARTUP=true
WARM_UP_TTS_ON_STARTUP=true

# Use kyutai_pocket for local CPU synthesis or google for Chirp.
TTS_BACKEND=kyutai_pocket
TTS_MODEL=english
# For Google, set this to en-GB-Chirp3-HD-Aoede.
TTS_VOICE=alba
TTS_LANGUAGE_CODE=en-GB
TTS_QUANTIZE=false

CONVERSATION_LOGGING_ENABLED=true
CONVERSATION_LOG_DIRECTORY=runtime_logs/conversations