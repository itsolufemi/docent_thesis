# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# Framework and application runtime data
framework/.env
framework/venv/
framework/tests/runtime_logs/
apps/docent/runtime_logs/

# Python generated files
__pycache__/
*.py[cod]

# Generated Docent vector store
apps/docent/data/vector_store/*.npy
apps/docent/data/vector_store/*.json

# Dependencies and local development output
node_modules/
apps/docent/frontend/vite-dev*.log
*.wav
*.env
.tmp.driveupload/
.tmp.drivedownload/
.agents/

# Generated Ollama cold-start benchmark log
framework/tests/_archive/benchmarks/results/03_ollama_startup.log

# Build output
dist/

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# Local research library
__lib/
